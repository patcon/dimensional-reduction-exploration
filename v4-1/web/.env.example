# Copy to .env (git ignores it). Wrangler reads it for `pnpm run deploy`, in place of `pnpm wrangler login`.
# Create a token from the "Edit Cloudflare Workers" template: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# Only needed if the token can reach more than one account.
# CLOUDFLARE_ACCOUNT_ID=
